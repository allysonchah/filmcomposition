              "border-radius": "2rem"
            },
            ".mbr-section-title": {
              "color": "#f7f7f7",
              "text-align": "center"
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff",
              "text-align": "center"
            },
            ".mbr-box": {
